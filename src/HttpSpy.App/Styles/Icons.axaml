<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Vector icons on a 24x24 grid.

    These replace the Unicode glyphs the interface used to draw with (U+2697
    ALEMBIC, U+2441, U+25EB and friends). Those are rare enough that whether they
    render as an icon, a fallback box or a colour emoji depends entirely on which
    fonts the machine happens to have — which is not something an application
    should leave to chance. Paths always draw the same thing everywhere and
    inherit the current foreground brush.
  -->

  <!-- Analyse: a laboratory flask. -->
  <StreamGeometry x:Key="IconFlask">
    M9,2 L15,2 L15,4 L14,4 L14,9.1 L19.4,18.1 C20.2,19.4 19.3,21 17.8,21
    L6.2,21 C4.7,21 3.8,19.4 4.6,18.1 L10,9.1 L10,4 L9,4 Z
    M11.6,10.2 L8.2,16 L15.8,16 L12.4,10.2 Z
  </StreamGeometry>

  <!-- Empty capture: concentric rings, the "listening, nothing yet" idea. -->
  <StreamGeometry x:Key="IconRadar">
    M12,2 A10,10 0 1,1 2,12 A10,10 0 0,1 12,2 Z
    M12,4 A8,8 0 1,0 20,12 A8,8 0 0,0 12,4 Z
    M12,7.5 A4.5,4.5 0 1,1 7.5,12 A4.5,4.5 0 0,1 12,7.5 Z
    M12,9.5 A2.5,2.5 0 1,0 14.5,12 A2.5,2.5 0 0,0 12,9.5 Z
    M12,10.9 A1.1,1.1 0 1,1 10.9,12 A1.1,1.1 0 0,1 12,10.9 Z
  </StreamGeometry>

  <!-- Empty inspector: a pane split into a list and a detail area. -->
  <StreamGeometry x:Key="IconPanels">
    M3,4 L21,4 L21,20 L3,20 Z
    M5,6 L5,18 L9.5,18 L9.5,6 Z
    M11.5,6 L11.5,18 L19,18 L19,6 Z
  </StreamGeometry>

  <!-- Empty dashboard: a bar chart. -->
  <StreamGeometry x:Key="IconChart">
    M3,20 L21,20 L21,21.6 L3,21.6 Z
    M4.5,12 L8,12 L8,18.6 L4.5,18.6 Z
    M10.2,7 L13.7,7 L13.7,18.6 L10.2,18.6 Z
    M16,10 L19.5,10 L19.5,18.6 L16,18.6 Z
  </StreamGeometry>

  <!-- Empty structure: a hierarchy. -->
  <StreamGeometry x:Key="IconTree">
    M10,3 L14,3 L14,7 L10,7 Z
    M11.4,7 L12.6,7 L12.6,10.4 L11.4,10.4 Z
    M5,10.4 L19,10.4 L19,11.6 L5,11.6 Z
    M5,11 L6.2,11 L6.2,14 L5,14 Z
    M11.4,11 L12.6,11 L12.6,14 L11.4,14 Z
    M17.8,11 L19,11 L19,14 L17.8,14 Z
    M3.4,14 L7.8,14 L7.8,18 L3.4,18 Z
    M9.8,14 L14.2,14 L14.2,18 L9.8,18 Z
    M16.2,14 L20.6,14 L20.6,18 L16.2,18 Z
  </StreamGeometry>

  <!-- Nothing to report: a tick. -->
  <StreamGeometry x:Key="IconCheck">
    M9.4,16.2 L4.8,11.6 L3.4,13 L9.4,19 L21,7.4 L19.6,6 Z
  </StreamGeometry>

</ResourceDictionary>

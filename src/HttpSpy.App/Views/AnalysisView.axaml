<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HttpSpy.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="HttpSpy.App.Views.AnalysisView"
             x:DataType="vm:AnalysisViewModel"
             x:Name="AnalysisRoot">

    <DockPanel>
        <!-- ===== Action bar ===== -->
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <WrapPanel Classes="spaced">
                <Button Classes="primary" Command="{Binding RunAnalysisCommand}"
                        IsEnabled="{Binding !IsRunning}"
                        ToolTip.Tip="Inspect every captured transaction for security, performance, caching and correctness issues">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⚗"/>
                        <TextBlock Text="Analyse capture"/>
                    </StackPanel>
                </Button>

                <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center"
                             IsVisible="{Binding IsRunning}"/>

                <Border Classes="vsep" IsVisible="{Binding HasReport}"/>

                <TextBlock Text="Severity:" VerticalAlignment="Center" Classes="muted"
                           IsVisible="{Binding HasReport}"/>
                <ComboBox ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}"
                          MinWidth="110" IsVisible="{Binding HasReport}"/>

                <TextBlock Text="Category:" VerticalAlignment="Center" Classes="muted"
                           IsVisible="{Binding HasReport}"/>
                <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}"
                          MinWidth="130" IsVisible="{Binding HasReport}"/>

                <TextBox Text="{Binding SearchText}" Width="200" Watermark="filter findings…"
                         IsVisible="{Binding HasReport}"/>
                <Button Content="Reset" Classes="ghost" Command="{Binding ClearFiltersCommand}"
                        IsVisible="{Binding HasReport}"/>

                <Border Classes="vsep" IsVisible="{Binding HasReport}"/>

                <DropDownButton Content="Export report" IsVisible="{Binding HasReport}">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="HTML report…" Command="{Binding ExportHtmlCommand}"/>
                            <MenuItem Header="Plain text…" Command="{Binding ExportTextCommand}"/>
                            <MenuItem Header="JSON (for CI)…" Command="{Binding ExportJsonCommand}"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </WrapPanel>
        </Border>

        <!-- ===== Summary strip ===== -->
        <Border DockPanel.Dock="Top" Classes="chrome" BorderThickness="0,0,0,1" Padding="14,10"
                IsVisible="{Binding HasReport}">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <!-- Score -->
                <Border Grid.Column="0" Classes="panel" Padding="18,10" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Health score" Classes="kpiLabel"/>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="{Binding OverallScore}" Classes="kpiValue"
                                       Foreground="{Binding OverallScore, Converter={StaticResource ScoreToBrush}}"/>
                            <TextBlock Text="/100" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Verdict}" Classes="muted" TextWrapping="Wrap" MaxWidth="230"/>
                    </StackPanel>
                </Border>

                <!-- Severity counters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="panel" Padding="14,8" MinWidth="86">
                        <StackPanel>
                            <TextBlock Text="Critical" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding CriticalCount}" FontSize="22" FontWeight="Bold"
                                       Classes="danger"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel" Padding="14,8" MinWidth="86">
                        <StackPanel>
                            <TextBlock Text="High" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding HighCount}" FontSize="22" FontWeight="Bold"
                                       Classes="warning"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel" Padding="14,8" MinWidth="86">
                        <StackPanel>
                            <TextBlock Text="Medium" Classes="kpiLabel"/>
                            <TextBlock Text="{Binding MediumCount}" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel" Padding="14,8" MinWidth="86">
                        <StackPanel>
                            <TextBlock Text="Low / Info" Classes="kpiLabel"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding LowCount}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="/" FontSize="18" Classes="muted" VerticalAlignment="Bottom"/>
                                <TextBlock Text="{Binding InfoCount}" FontSize="18" Classes="muted"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Per-category scores -->
                <ScrollViewer Grid.Column="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                              MaxHeight="130">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryScoreViewModel">
                                <Grid ColumnDefinitions="120,Auto,*" Margin="0,2"
                                      ToolTip.Tip="{Binding Breakdown}">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Score}" MinWidth="34"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                               TextAlignment="Right" Margin="0,0,8,0"
                                               Foreground="{Binding Score, Converter={StaticResource ScoreToBrush}}"/>
                                    <Rectangle Grid.Column="2" Height="10" RadiusX="3" RadiusY="3"
                                               HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                               Fill="{Binding Score, Converter={StaticResource ScoreToBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== Status line ===== -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <TextBlock Text="{Binding SummaryLine}" Classes="muted"/>
        </Border>

        <!-- ===== Findings ===== -->
        <Panel>
            <ScrollViewer Padding="14,10" IsVisible="{Binding Findings.Count, Converter={StaticResource CountToBool}}">
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FindingViewModel">
                            <Border Background="{DynamicResource SpySurfaceBrush}"
                                    BorderBrush="{DynamicResource SpyBorderBrush}"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="8" Padding="14,11" Margin="0,0,0,9">
                                <StackPanel Spacing="5">
                                    <!-- Heading: severity badge + title + occurrences -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="badge" Margin="0,0,10,0"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding SeverityText}"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border Classes="pill" IsVisible="{Binding IsRepeated}">
                                                <TextBlock Text="{Binding OccurrenceText}"
                                                           Foreground="{DynamicResource SpyTextMutedBrush}"/>
                                            </Border>
                                            <Button Classes="ghost" Content="Go to session"
                                                    FontSize="11"
                                                    Command="{Binding #AnalysisRoot.DataContext.GoToSessionCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding SessionsText}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Subject}" Classes="mono faint"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SpyTextMutedBrush}"/>

                                    <Border IsVisible="{Binding HasEvidence}"
                                            Background="{DynamicResource SpyBackgroundBrush}"
                                            BorderBrush="{DynamicResource SpyBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,5">
                                        <SelectableTextBlock Text="{Binding Evidence}" Classes="mono"
                                                             TextWrapping="Wrap"/>
                                    </Border>

                                    <Border IsVisible="{Binding HasRemediation}"
                                            BorderBrush="{DynamicResource SpySuccessBrush}"
                                            BorderThickness="3,0,0,0" Padding="9,1,0,1">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Fix:" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Remediation}"/>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Classes="faint" FontSize="11">
                                        <Run Text="{Binding RuleId}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding CategoryText}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding SessionsText}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state: never analysed -->
            <StackPanel Classes="empty-state"
                        IsVisible="{Binding !HasReport}">
                <TextBlock Text="⚗" Classes="glyph"/>
                <TextBlock Text="Analyse this capture" Classes="title"/>
                <TextBlock Text="HttpSpy inspects every captured transaction for missing security headers, leaked credentials, cache mistakes, slow or oversized responses, malformed payloads and N+1 request patterns — then scores the result and tells you how to fix each finding."/>
                <Button Classes="primary" Content="Run analysis" HorizontalAlignment="Center"
                        Command="{Binding RunAnalysisCommand}" IsEnabled="{Binding !IsRunning}"/>
            </StackPanel>

            <!-- Empty state: analysed, nothing to report (or filtered out) -->
            <StackPanel Classes="empty-state">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasReport"/>
                        <Binding Path="Findings.Count" Converter="{StaticResource CountToBool}"
                                 ConverterParameter="invert"/>
                    </MultiBinding>
                </StackPanel.IsVisible>
                <TextBlock Text="✓" Classes="glyph"/>
                <TextBlock Text="Nothing to report" Classes="title"/>
                <TextBlock Text="No findings match the current filters. Widen the severity or category filter, or capture more traffic and analyse again."/>
            </StackPanel>
        </Panel>
    </DockPanel>
</UserControl>

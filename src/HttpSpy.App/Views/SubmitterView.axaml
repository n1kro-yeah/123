<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HttpSpy.App.ViewModels"
             xmlns:l="using:HttpSpy.App.Localization"
             xmlns:ctl="using:HttpSpy.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="HttpSpy.App.Views.SubmitterView"
             x:DataType="vm:SubmitterViewModel">

    <Grid RowDefinitions="Auto,Auto,*,4,*" Margin="8">
        <!-- request line -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" MinWidth="110"/>
            <TextBox Text="{Binding Url}" Width="640" Watermark="{l:T Sub.UrlPlaceholder}"/>
            <Button Content="{l:T Sub.Send}" Command="{Binding SendCommand}" IsEnabled="{Binding !IsSending}" MinWidth="80"/>
            <TextBlock Text="{Binding ResponseStatus}" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" Foreground="#FFB0C4DE"/>
        </StackPanel>

        <!-- import from cURL -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{l:T Sub.ImportCurl}" VerticalAlignment="Center"/>
            <TextBox Text="{Binding CurlImport}" Width="640"
                     Watermark="{l:T Sub.CurlPlaceholder}"
                     ToolTip.Tip="Parses -X/-H/-d/--data/--json/-G/-u and fills the composer"/>
            <Button Content="{l:T Sub.Import}" Command="{Binding ImportCurlCommand}" MinWidth="80"/>
        </StackPanel>

        <!-- request editor -->
        <Grid Grid.Row="2" ColumnDefinitions="*,8,*">
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{l:T Sub.RequestHeaders}" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding HeadersText}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{l:T Sub.RequestBody}" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding BodyText}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
            </DockPanel>
        </Grid>

        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#33FFFFFF"/>

        <!-- response -->
        <Grid Grid.Row="4" ColumnDefinitions="*,8,2*">
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{l:T Sub.ResponseHeaders}" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ResponseHeaders, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{l:T Sub.ResponseBody}" FontWeight="Bold" Margin="0,0,0,4"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="6">
                    <SelectableTextBlock ctl:HighlightBehavior.SourceText="{Binding ResponseBody}"
                                         ctl:HighlightBehavior.Language="{Binding ResponseBodyLanguage}"
                                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                         TextWrapping="NoWrap"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>

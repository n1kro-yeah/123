<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HttpSpy.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="HttpSpy.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <Panel>
    <ScrollViewer IsVisible="{Binding Total, Converter={StaticResource CountToBool}}">
        <StackPanel Margin="16" Spacing="18">
            <!-- KPI cards -->
            <WrapPanel>
                <Border Classes="card"><StackPanel><TextBlock Text="Requests" Classes="kpiLabel"/><TextBlock Text="{Binding Total}" Classes="kpiValue"/></StackPanel></Border>
                <Border Classes="card"><StackPanel><TextBlock Text="Transferred" Classes="kpiLabel"/><TextBlock Text="{Binding TotalBytes}" Classes="kpiValue"/></StackPanel></Border>
                <Border Classes="card"><StackPanel><TextBlock Text="Avg time" Classes="kpiLabel"/><TextBlock Text="{Binding AvgDuration}" Classes="kpiValue"/></StackPanel></Border>
                <Border Classes="card"><StackPanel><TextBlock Text="Errors" Classes="kpiLabel"/><TextBlock Text="{Binding Errors}" Classes="kpiValue"/></StackPanel></Border>
                <Border Classes="card"><StackPanel><TextBlock Text="HTTPS" Classes="kpiLabel"/><TextBlock Text="{Binding HttpsCount}" Classes="kpiValue"/></StackPanel></Border>
            </WrapPanel>

            <TextBlock Text="Status code distribution" Classes="section"/>
            <ItemsControl ItemsSource="{Binding StatusDistribution}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="170,Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Height="18" HorizontalAlignment="Left"
                                       Width="{Binding BarWidth}" Fill="{Binding Brush}" RadiusX="3" RadiusY="3"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Top hosts" Classes="section"/>
            <ItemsControl ItemsSource="{Binding TopHosts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="230,Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Rectangle Grid.Column="1" Height="18" HorizontalAlignment="Left"
                                       Width="{Binding BarWidth}" Fill="{Binding Brush}" RadiusX="3" RadiusY="3"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Content types" Classes="section"/>
            <ItemsControl ItemsSource="{Binding ContentTypes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="230,Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Rectangle Grid.Column="1" Height="18" HorizontalAlignment="Left"
                                       Width="{Binding BarWidth}" Fill="{Binding Brush}" RadiusX="3" RadiusY="3"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Methods" Classes="section"/>
            <ItemsControl ItemsSource="{Binding Methods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="170,Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Height="18" HorizontalAlignment="Left"
                                       Width="{Binding BarWidth}" Fill="{Binding Brush}" RadiusX="3" RadiusY="3"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Top processes" Classes="section"/>
            <ItemsControl ItemsSource="{Binding TopProcesses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="230,Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Rectangle Grid.Column="1" Height="18" HorizontalAlignment="Left"
                                       Width="{Binding BarWidth}" Fill="{Binding Brush}" RadiusX="3" RadiusY="3"/>
                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Requests over time" Classes="section"/>
            <ItemsControl ItemsSource="{Binding TimeChart}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Bottom" Width="48">
                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Center" FontSize="11"/>
                            <Rectangle Width="34" Height="{Binding BarWidth}" HorizontalAlignment="Center"
                                       Fill="{Binding Brush}" RadiusX="2" RadiusY="2"/>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="10"
                                       Foreground="{DynamicResource SpyTextMutedBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>

    <StackPanel Classes="empty-state"
                IsVisible="{Binding Total, Converter={StaticResource CountToBool}, ConverterParameter=invert}">
        <TextBlock Text="◫" Classes="glyph"/>
        <TextBlock Text="Nothing to chart yet" Classes="title"/>
        <TextBlock Text="Capture some traffic and the status-code mix, busiest hosts, content types, methods, originating processes and request rate over time all appear here."/>
    </StackPanel>
  </Panel>
</UserControl>
